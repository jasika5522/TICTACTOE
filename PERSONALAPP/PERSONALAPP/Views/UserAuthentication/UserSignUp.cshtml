@{
    Layout = "_LayoutAuthentication";
    ViewData["Title"] = "Create Account | PERSONALAPP";
    var registerUrl = Url.Action("Register", "UserAuthentication") ?? "/UserAuthentication/Register";
    var loginUrl = Url.Action("UserLogin", "UserAuthentication") ?? "/UserAuthentication/UserLogin";
}

<div class="auth-shell">
    <aside class="auth-brand" aria-label="Welcome">
        <div class="auth-brand-grid" aria-hidden="true"></div>
        <div class="auth-orb auth-orb--1" aria-hidden="true"></div>
        <div class="auth-orb auth-orb--2" aria-hidden="true"></div>
        <div class="auth-brand-content">
            <a class="auth-logo" href="/" aria-label="PERSONALAPP home">
                <span class="auth-logo-mark"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                PERSONALAPP
            </a>
            <h1>Join <span>PERSONALAPP</span></h1>
            <p>Create your account in minutes. Registration is connected to the Portfolio Service through the Ocelot API Gateway.</p>
            <ul class="auth-brand-features">
                <li><i class="bi bi-person-check" aria-hidden="true"></i> Secure server-side registration flow</li>
                <li><i class="bi bi-lock" aria-hidden="true"></i> Passwords hashed before storage</li>
                <li><i class="bi bi-hdd-network" aria-hidden="true"></i> Gateway → Portfolio Service → PostgreSQL</li>
            </ul>
        </div>
    </aside>

    <section class="auth-panel">
        <header class="auth-panel-header">
            <a class="auth-logo" href="/" aria-label="PERSONALAPP home">
                <span class="auth-logo-mark"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                PERSONALAPP
            </a>
            <a class="auth-nav-link" asp-controller="UserAuthentication" asp-action="UserLogin">
                Login <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </header>

        <div class="auth-card">
            <h2 class="auth-card-title">Create account</h2>
            <p class="auth-card-subtitle">Fill in your details to get started.</p>

            <div class="auth-alert" role="alert" aria-live="polite"></div>

            <form id="signupForm" novalidate data-register-url="@registerUrl" data-login-url="@loginUrl">
                <div class="auth-field">
                    <label class="auth-label" for="signupFullName">Full Name</label>
                    <input class="auth-input" type="text" id="signupFullName" name="fullName" autocomplete="name" placeholder="Jasika Saha" required />
                    <div class="auth-feedback"></div>
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="signupEmail">Email Address</label>
                    <input class="auth-input" type="email" id="signupEmail" name="email" autocomplete="email" placeholder="you@example.com" required />
                    <div class="auth-feedback"></div>
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="signupMobile">Mobile Number</label>
                    <input class="auth-input" type="tel" id="signupMobile" name="mobile" autocomplete="tel" inputmode="numeric" maxlength="10" placeholder="10-digit mobile number" required />
                    <div class="auth-feedback"></div>
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="signupPassword">Password</label>
                    <div class="auth-input-wrap">
                        <input class="auth-input" type="password" id="signupPassword" name="password" autocomplete="new-password" placeholder="Minimum 8 characters" required minlength="8" />
                        <button type="button" class="auth-toggle-pw" data-toggle-password="signupPassword" aria-label="Show password">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="auth-feedback"></div>
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="signupConfirmPassword">Confirm Password</label>
                    <div class="auth-input-wrap">
                        <input class="auth-input" type="password" id="signupConfirmPassword" name="confirmPassword" autocomplete="new-password" placeholder="Re-enter password" required />
                        <button type="button" class="auth-toggle-pw" data-toggle-password="signupConfirmPassword" aria-label="Show confirm password">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="auth-feedback"></div>
                </div>

                <div class="auth-field">
                    <label class="auth-check">
                        <input type="checkbox" id="signupTerms" name="terms" required />
                        <span>I agree to the <a class="auth-link" href="#" onclick="return false;">Terms &amp; Conditions</a></span>
                    </label>
                    <div class="auth-feedback"></div>
                </div>

                <button type="submit" class="auth-btn">
                    <span class="auth-btn-spinner" aria-hidden="true"></span>
                    <span class="auth-btn-label">Create Account</span>
                </button>

                <p class="auth-footer-text">
                    Already have an account?
                    <a class="auth-link" asp-controller="UserAuthentication" asp-action="UserLogin">Login</a>
                </p>
            </form>
        </div>
    </section>
</div>
