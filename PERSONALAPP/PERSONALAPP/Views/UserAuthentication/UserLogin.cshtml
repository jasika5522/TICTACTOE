@{
    Layout = "_LayoutAuthentication";
    ViewData["Title"] = "Sign In | PERSONALAPP";
}

<div class="auth-shell">
    <aside class="auth-brand" aria-label="Welcome">
        <div class="auth-brand-grid" aria-hidden="true"></div>
        <div class="auth-orb auth-orb--1" aria-hidden="true"></div>
        <div class="auth-orb auth-orb--2" aria-hidden="true"></div>
        <div class="auth-brand-content">
            <a class="auth-logo" href="/" aria-label="PERSONALAPP home">
                <span class="auth-logo-mark"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                PERSONALAPP
            </a>
            <h1>Welcome back to <span>PERSONALAPP</span></h1>
            <p>Sign in to access your workspace. Secure, modern, and built for a seamless experience when backend authentication is connected.</p>
            <ul class="auth-brand-features">
                <li><i class="bi bi-shield-check" aria-hidden="true"></i> Enterprise-ready sign-in experience</li>
                <li><i class="bi bi-lightning-charge" aria-hidden="true"></i> Fast, responsive interface</li>
                <li><i class="bi bi-phone" aria-hidden="true"></i> Optimized for every device</li>
            </ul>
        </div>
    </aside>

    <section class="auth-panel">
        <header class="auth-panel-header">
            <a class="auth-logo" href="/" aria-label="PERSONALAPP home">
                <span class="auth-logo-mark"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                PERSONALAPP
            </a>
            <a class="auth-nav-link" asp-controller="UserAuthentication" asp-action="UserSignUp">
                Sign Up <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </header>

        <div class="auth-card">
            <h2 class="auth-card-title">Sign in</h2>
            <p class="auth-card-subtitle">Enter your credentials to continue.</p>

            <div class="auth-alert" role="alert" aria-live="polite"></div>

            <form id="loginForm" novalidate>
                <div class="auth-field">
                    <label class="auth-label" for="loginEmail">Email Address</label>
                    <input class="auth-input" type="email" id="loginEmail" name="email" autocomplete="email" placeholder="you@example.com" required />
                    <div class="auth-feedback"></div>
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="loginPassword">Password</label>
                    <div class="auth-input-wrap">
                        <input class="auth-input" type="password" id="loginPassword" name="password" autocomplete="current-password" placeholder="••••••••" required />
                        <button type="button" class="auth-toggle-pw" data-toggle-password="loginPassword" aria-label="Show password">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="auth-feedback"></div>
                </div>

                <div class="auth-row">
                    <label class="auth-check">
                        <input type="checkbox" id="rememberMe" name="rememberMe" />
                        Remember Me
                    </label>
                    <a class="auth-link" href="#" onclick="return false;">Forgot Password?</a>
                </div>

                <button type="submit" class="auth-btn">
                    <span class="auth-btn-spinner" aria-hidden="true"></span>
                    <span class="auth-btn-label">Login</span>
                </button>

                <div class="auth-divider">Or</div>

                <button type="button" class="auth-social" aria-label="Sign in with Google (visual demo only)">
                    <i class="bi bi-google" aria-hidden="true"></i>
                    Continue with Google
                </button>

                <p class="auth-footer-text">
                    Don't have an account?
                    <a class="auth-link" asp-controller="UserAuthentication" asp-action="UserSignUp">Create Account</a>
                </p>
            </form>
        </div>
    </section>
</div>
